# 仅为配置示例；程序不会自动加载此文件或 .env。
# 真实密钥由你在本地设置，示例中保持为空。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.likeai520.cc/v1
OPENAI_MODEL=gpt-6-sol
# 非默认模型必须提供对应服务商单价（美元/百万 token）；默认沿用项目已确认的中转价。
JOB_AGENT_INPUT_PRICE_USD_PER_MILLION=0.30
JOB_AGENT_OUTPUT_PRICE_USD_PER_MILLION=1.50

# 质量参数：不设置时按任务选择；这些配置不构成付费/资料传输授权。
# PLATFORM_MAX_OUTPUT_TOKENS=4096
# PLATFORM_REASONING_EFFORT=medium
# JOB_AGENT_MAX_OUTPUT_TOKENS=8192
# JOB_AGENT_REASONING_EFFORT=medium
# JOB_AGENT_MAX_REQUESTS=6
# JOB_AGENT_BUDGET_RMB=1.0
# JOB_AGENT_PREPARATION_PASSES=2
# JOB_AGENT_TIMEOUT_SECONDS=120
